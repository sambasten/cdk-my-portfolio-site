{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit(/mysite/**)",
      "Edit(/.claude/**)",
      "Bash(python3 -m http.server *)",
      "Bash(sips *)",
      "Bash(cwebp *)",
      "Bash(magick *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(/infra/**)",
      "Edit(/.github/**)",
      "Bash(cdk *)",
      "Bash(npx cdk *)",
      "Bash(npm run cdk *)",
      "Bash(aws *)",
      "Bash(rm -rf *)"
    ]
  }
}
