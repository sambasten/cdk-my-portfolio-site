{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit(/mysite/**)",
      "Edit(/.claude/**)",
      "Bash(python3 -m http.server *)",
      "Bash(sips *)",
      "Bash(cwebp *)",
      "Bash(magick *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Edit(/bin/**)",
      "Edit(/lib/**)",
      "Edit(/test/**)",
      "Edit(/.github/**)",
      "Edit(/cdk.json)",
      "Edit(/cdk.context.json)",
      "Edit(/package.json)",
      "Edit(/package-lock.json)",
      "Edit(/tsconfig.json)",
      "Edit(/jest.config.js)",
      "Edit(/.npmignore)",
      "Edit(/.gitignore)",
      "Bash(cdk *)",
      "Bash(npx cdk *)",
      "Bash(npm run cdk *)",
      "Bash(aws *)",
      "Bash(rm -rf *)"
    ]
  }
}
